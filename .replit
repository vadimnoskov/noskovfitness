modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fitness-engine-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fitness-typechecks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fitness-browser-check"

[[workflows.workflow]]
name = "fitness-engine-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/fitness-core test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "fitness-typechecks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:libs && pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/noskov-fitness typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "fitness-browser-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts test:fitness-ui"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
