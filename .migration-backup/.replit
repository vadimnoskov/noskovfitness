modules = ["web", "nodejs-20", "python-3.12"]
run = "npm run dev"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci --include=dev && npm run db:migrate && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80

[nix]
channel = "stable-25_05"
