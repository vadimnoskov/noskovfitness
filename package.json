{
  "name": "noskov-fitness",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "movements:report": "tsx tools/movement-report.ts",
    "check": "npm test -w @nf/core && tsc --noEmit -p . && tsc --noEmit -p apps/web",
    "dev": "npm run dev -w @nf/web",
    "build": "npm run build -w @nf/web",
    "start": "npm run start -w @nf/web",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:import": "tsx packages/db/src/import.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "type": "module"
}